%% Balance Planner — Data Flow

flowchart TD
    subgraph Input
        Priorities[Weekly priorities<br/>entered in dashboard]
        CheckinResponse[Check-in response<br/>marked in-app]
    end

    subgraph Processing
        direction TB
        Scheduler[Scheduler<br/>per-user, timezone-aware]
        PlanJob[Build plan request:<br/>plan items + priorities<br/>+ categories]
        TrendJob[Trend job:<br/>multi-week pattern analysis<br/>every 2-4 weeks]
        DataCheck{Has 2-4+ weeks<br/>of feedback?}
        ClaudePlan[Claude: draft week]
        ClaudeRec[Claude: personalized suggestion<br/>for this week's missed items]
        ClaudeTrend[Claude: identify<br/>recurring patterns]
        GenericRec[Generic suggestion<br/>+ disclaimer]
        DraftPendingCheck{Draft unapproved<br/>~48h?}
        NotifGateDraft{Notified in<br/>last 7 days?}
        InactivityCheck{Inactive 14+ days,<br/>not renotified<br/>in 30 days?}
        NotifGateReengage{Notified in<br/>last 7 days?}
    end

    subgraph Storage
        direction TB
        DB[(Postgres<br/>users, accounts, preferences<br/>plan items, drafts, feedback<br/>recommendations, notifications)]
        Cache[(Redis<br/>cache, job queue)]
    end

    subgraph Output
        direction TB
        Draft[Draft schedule]
        Approved[Approved schedule]
        Reminder[Email: check-in ready]
        DraftNudge[Email: draft still<br/>pending approval]
        ReEngagementNudge[Email: re-engagement]
        Suppressed[Suppressed —<br/>no email sent]
        WeekSuggestion[This week's suggestion]
        ProgressPopup[Progress popup<br/>week N of 2-4]
        PatternInsight[Pattern insight]
        DigestScreen[Digest screen<br/>forced on next login]
        HomeCard[Home screen card<br/>not gating]
    end

    Priorities --> PlanJob
    DB -->|"existing plan items"| PlanJob
    PlanJob --> ClaudePlan
    ClaudePlan --> Draft
    Draft -->|"approve"| Approved
    Approved --> DB

    Scheduler -->|"enqueue: reminder, weekly"| Cache
    Cache -->|"trigger: end of week"| Reminder
    Reminder -->|"logged"| DB
    Reminder -->|"opens app on next login"| CheckinResponse
    CheckinResponse -->|"missed items flagged"| DB
    CheckinResponse --> DataCheck

    DataCheck -->|"no"| GenericRec
    DataCheck -->|"yes"| ClaudeRec
    GenericRec --> WeekSuggestion
    GenericRec --> ProgressPopup
    ClaudeRec --> WeekSuggestion
    WeekSuggestion --> DB
    ProgressPopup --> DigestScreen
    DB -->|"this week's suggestion"| DigestScreen

    Scheduler -->|"enqueue: trend refresh, every 2-4 weeks"| Cache
    Cache -->|"trigger: trend analysis"| TrendJob
    DB -->|"full history"| TrendJob
    TrendJob -->|"only once 2-4+ weeks exist"| ClaudeTrend
    ClaudeTrend --> PatternInsight
    PatternInsight --> DB
    DB -->|"recurring patterns"| HomeCard

    Scheduler -->|"enqueue: draft-pending check, daily"| Cache
    Cache -->|"trigger: unapproved drafts"| DraftPendingCheck
    DB -->|"draft age"| DraftPendingCheck
    DraftPendingCheck -->|"yes"| NotifGateDraft
    DraftPendingCheck -->|"no"| Suppressed
    DB -->|"notification history"| NotifGateDraft
    NotifGateDraft -->|"no"| DraftNudge
    NotifGateDraft -->|"yes"| Suppressed
    DraftNudge -->|"logged"| DB

    Scheduler -->|"enqueue: inactivity check, daily"| Cache
    Cache -->|"trigger: last login age"| InactivityCheck
    DB -->|"lastLoginAt"| InactivityCheck
    InactivityCheck -->|"yes"| NotifGateReengage
    InactivityCheck -->|"no"| Suppressed
    DB -->|"notification history"| NotifGateReengage
    NotifGateReengage -->|"no"| ReEngagementNudge
    NotifGateReengage -->|"yes"| Suppressed
    ReEngagementNudge -->|"logged"| DB

    classDef input fill:#dbeafe,stroke:#2563eb,color:#1e3a5f,stroke-width:1.5px
    classDef storage fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:1.5px
    classDef processing fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:1.5px
    classDef output fill:#fce7f3,stroke:#db2777,color:#831843,stroke-width:1.5px

    class Priorities,CheckinResponse input
    class DB,Cache storage
    class Scheduler,PlanJob,TrendJob,DataCheck,ClaudePlan,ClaudeRec,ClaudeTrend,GenericRec,DraftPendingCheck,NotifGateDraft,InactivityCheck,NotifGateReengage processing
    class Draft,Approved,Reminder,DraftNudge,ReEngagementNudge,Suppressed,WeekSuggestion,ProgressPopup,PatternInsight,DigestScreen,HomeCard output
