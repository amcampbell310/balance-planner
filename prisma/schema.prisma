// Prisma schema for Balance Planner
// Maps to the DB fields referenced across diagrams/*.mmd:
// users, accounts, preferences, plan items, drafts, feedback, recommendations, history
//
// Auth: Auth.js with JWT sessions (see diagrams/architecture.mmd) — no Session or
// VerificationToken model needed. Login is OAuth-only (Google, Microsoft, Apple),
// so there's no email/magic-link verification flow either.

generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Prisma 7 — the `url` field here
// is deprecated). PrismaClient's actual runtime connection is configured
// separately via a driver adapter — see src/backend/db.ts.
datasource db {
  provider = "postgresql"
}

enum Category {
  WORK
  SOCIAL
  GAMING
  FITNESS
  CHORES
}

enum PlanItemStatus {
  PLANNED
  DONE
  MISSED
  SKIPPED
}

enum PlanItemSource {
  CLAUDE_DRAFT
  MANUAL
}

enum DraftStatus {
  PENDING
  APPROVED
}

enum CheckInStatus {
  PENDING
  COMPLETED
}

enum RecommendationType {
  WEEKLY_SUGGESTION
  PATTERN_INSIGHT
}

enum RecommendationStatus {
  ACTIVE
  DISMISSED
  ACTED_ON
}

// Every reminder/nudge email sent, of any kind — the single source of truth
// for anti-spam throttling. CHECK_IN_REMINDER is the core weekly loop and
// always fires. DRAFT_PENDING and RE_ENGAGEMENT are subordinate: before
// sending either, check whether this user has received ANY notification in
// the last 7 days — if so, hold off. This keeps "extra" nudges from ever
// stacking with each other or with the core check-in reminder.
// DRAFT_PENDING fires at most once per WeeklyPlan (never repeats for the
// same draft). RE_ENGAGEMENT fires after ~14 days of inactivity, then is
// suppressed for 30 days before it can fire again.
enum NotificationType {
  CHECK_IN_REMINDER
  DRAFT_PENDING
  RE_ENGAGEMENT
}

// Auth.js Prisma adapter model — links an OAuth provider identity to a User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model User {
  id    String    @id @default(cuid())
  name  String?
  email String?   @unique
  // Required by Auth.js's Prisma adapter contract — every OAuth provider's
  // profile is treated as pre-verified, so this is set on createUser and
  // never surfaced in the app itself. Credentials signup (src/app/api/auth/signup/route.ts)
  // sets it too, at signup time — there's no real email-verification flow
  // (no confirmation email) for either path, so this matches the app's
  // existing lightweight trust posture rather than adding a new one.
  emailVerified DateTime?
  image String?
  // Null for OAuth-only accounts. bcrypt hash, never the raw password — see
  // src/app/api/auth/signup/route.ts and the Credentials provider in
  // src/backend/auth.ts.
  password String?

  // onboarding-flow.mmd
  timezone           String     @default("UTC")
  weekStartDay       Int        @default(1) // 0 = Sunday .. 6 = Saturday
  selectedCategories Category[]
  onboarded          Boolean    @default(false)

  // Drives RE_ENGAGEMENT notification eligibility (inactivity threshold).
  lastLoginAt DateTime?

  // Soft delete: account deletion sets deletedAt and the user is treated as
  // gone everywhere in the app immediately, but the row (and their data)
  // survives for a grace period before a scheduled purge job hard-deletes it.
  deletedAt DateTime?

  accounts        Account[]
  weeklyPlans     WeeklyPlan[]
  planItems       PlanItem[]
  checkIns        CheckIn[]
  recommendations Recommendation[]
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One per user per week — enforced below, not just documented.
// Holds Claude's raw draft plus the approval state.
// See user-flow.mmd: "plan the week" -> Draft -> Approved.
model WeeklyPlan {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekOf     DateTime // the user's week-start date this plan covers
  priorities String // raw "what do you want this week" input
  draftJson  Json // Claude's structured draft response
  status     DraftStatus @default(PENDING)
  approvedAt DateTime?

  // Regenerate has no natural cap the way initial draft creation does (that's
  // bounded to once/week by @@unique below) — this enforces one server-side,
  // see src/app/api/weekly-plan/[id]/regenerate/route.ts.
  regenerateCount Int @default(0)

  planItems       PlanItem[]
  checkIns        CheckIn[]
  recommendations Recommendation[]
  notifications   Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekOf])
}

// The individual scheduled blocks for a week. Either generated by Claude as
// part of a WeeklyPlan (source = CLAUDE_DRAFT, weeklyPlanId set) or added
// directly by the user outside the planning flow (source = MANUAL,
// weeklyPlanId optional). `weekOf` is stored directly on every item — not
// just inherited via weeklyPlan — so a check-in can find all of a week's
// items, manual or drafted, with a single query.
model PlanItem {
  id String @id @default(cuid())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  title     String
  category  Category
  startTime DateTime
  endTime   DateTime
  weekOf    DateTime
  source    PlanItemSource @default(CLAUDE_DRAFT)
  status    PlanItemStatus @default(PLANNED)

  // Why an item was missed or skipped — feeds the recommendation engine's
  // reasoning, not just the bare status.
  statusNote String?

  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekOf])
}

// Tracks the weekly check-in gate described in check-in-flow.mmd — pending
// after the Scheduler's reminder job fires, resolved once the user completes
// the forced digest screen on next login. Keyed on (userId, weekOf) rather
// than requiring a WeeklyPlan, so a manual-only week (no Claude draft ever
// generated) can still have a check-in.
model CheckIn {
  id String @id @default(cuid())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  weekOf      DateTime
  status      CheckInStatus @default(PENDING)
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, weekOf])
}

// Two distinct sources, distinguished by `type` (see data-flow.mmd):
// WEEKLY_SUGGESTION — synchronous, generated right after a check-in with
//   missed items; isGeneric is true until the user has 2-4+ weeks of data.
//   planItemId links it to the specific missed item it's about.
// PATTERN_INSIGHT — from the scheduled Recommendation Engine's multi-week
//   trend analysis; surfaces on the home screen, not gated behind login.
//   Spans multiple items/weeks, so planItemId is null.
//
// `status` tracks whether the user has done anything with it yet — it
// otherwise just accumulates with no way to mark it seen, dismissed, or
// acted on.
model Recommendation {
  id String @id @default(cuid())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)
  planItemId   String?
  planItem     PlanItem?   @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  type      RecommendationType
  category  Category?
  content   String
  isGeneric Boolean            @default(false)

  status      RecommendationStatus @default(ACTIVE)
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, status])
}

// Every reminder/nudge actually sent, of any type — see NotificationType for
// the anti-spam throttling rule this table exists to support. weeklyPlanId
// is set for CHECK_IN_REMINDER and DRAFT_PENDING (tied to a specific week's
// plan), null for RE_ENGAGEMENT (not tied to any one week).
model Notification {
  id String @id @default(cuid())

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String?
  weeklyPlan   WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  type   NotificationType
  sentAt DateTime         @default(now())

  @@index([userId, sentAt])
  @@index([userId, type, sentAt])
}
