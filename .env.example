# Copy to .env and fill in. Never commit .env.

# The app's own base URL — used to build links in reminder emails, sent
# from a background worker process with no request context of its own to
# infer this from. Update to the real deployed URL once this is hosted.
APP_URL="http://localhost:3000"

# Postgres (used by Prisma — see prisma/schema.prisma). The app's actual
# runtime connection (src/backend/db.ts) always uses this one.
DATABASE_URL="postgresql://user:password@localhost:5432/balance_planner"

# Only needed against a pooled connection (e.g. Supabase's PgBouncer) —
# schema migrations need a direct, non-pooled connection (see
# prisma.config.ts). Locally, where DATABASE_URL is already a direct
# connection, this can be left unset; it falls back to DATABASE_URL.
DIRECT_URL=""

# Redis (cache + job queue — Scheduler/Recommendation Engine worker).
# Default port is 6379; change it if that's already taken by another
# project's Redis on your machine (as it was during local dev setup here).
REDIS_URL="redis://localhost:6379"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# OAuth providers — see diagrams/onboarding-flow.mmd and diagrams/user-flow.mmd
# for why it's these three and no others.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Microsoft Entra ID (formerly Azure AD)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Apple Sign In — note: Apple does not issue a static client secret. It must
# be generated as a signed JWT (typically valid up to 6 months) from your
# Apple Developer account's private key. Revisit this before relying on it.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Claude API (weekly draft generation, missed-item suggestions, trend analysis)
ANTHROPIC_API_KEY=""

# Resend (reminder/notification emails) — https://resend.com
RESEND_API_KEY=""
